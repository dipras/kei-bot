# ID admin bot (bisa lebih dari satu, dipisah koma). Isi dengan digit dari sender ID WhatsApp
# apa adanya — bisa nomor HP (mis. 6281234567890) atau LID (mis. 246887756116087) tergantung
# apa yang dikirim WhatsApp Web untuk akun itu. Cek log bot / minta admin coba /setup lalu lihat
# senderId di error/log kalau belum yakin ID mana yang dipakai. Hanya digit yang dipakai untuk
# perbandingan (prefix +/0/spasi/dsb diabaikan).
ADMIN_NUMBERS=6281234567890

# Anthropic API key, dipakai khusus fitur /rangkum. Kosongkan kalau belum mau pakai fitur ini —
# bot akan balas pesan error yang jelas kalau /rangkum dipanggil tanpa key.
ANTHROPIC_API_KEY=

# Model Anthropic yang dipakai untuk /rangkum.
ANTHROPIC_MODEL=claude-sonnet-5

# Interval cek reminder deadline, dalam menit.
REMINDER_INTERVAL_MINUTES=10

# Jumlah pesan default yang diambil /rangkum kalau tidak dikasih argumen.
RANGKUM_DEFAULT_COUNT=50

# Lokasi file database SQLite.
DB_PATH=./data/kei-bot.sqlite3
